# 32+ char secret used to sign sessions and hash OTPs.
CONNEXA_SECRET=replace-with-a-long-random-string

# Set to 0 to disable the demo login / demo upgrade endpoints everywhere.
CONNEXA_DEMO_LOGIN=1

# Optional: SQLite file location
# CONNEXA_DB_PATH=./data/connexa.db

# Public Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
FIREBASE_PROJECT_ID=your-project-id

# Public Firebase client config
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
FIREBASE_PROJECT_ID=your-project-id

# Optional: enables POST /api/admin/reset (wipe all accounts). Leave unset to disable.
CONNEXA_ADMIN_TOKEN=
